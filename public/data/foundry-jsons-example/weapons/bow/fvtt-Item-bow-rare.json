    },
    "midi-qol": {
      "onUseMacroName": "[postAttackRoll]ItemMacro,[postDamageRoll]ItemMacro",
      "onUseMacroParts": {
        "items": [
          {
            "macroName": "ItemMacro",
            "option": "postAttackRoll"
          },
          {
            "macroName": "ItemMacro",
