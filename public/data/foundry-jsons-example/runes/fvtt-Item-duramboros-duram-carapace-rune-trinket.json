        "author": "",
        "img": "icons/svg/dice-target.svg",
        "command": "// Duram Carapace - Partbreaker (MidiQOL DamageBonus)\n// Extra 1d4 damage on a critical hit with a weapon attack.\n\nconst macroPass = String(args?.[0]?.macroPass ?? \"\").toLowerCase();\nif (macroPass && !macroPass.includes(\"damagebonus\")) return {};\n\nconst wf = workflow ?? args?.[0]?.workflow;\nif (!wf) return {};\n\nconst actType = String(wf.activity?.type ?? \"\").toLowerCase();\nconst isAttack = actType === \"attack\" || wf.item?.type === \"weapon\";\nif (!isAttack) return {};\n\nconst isCrit = Boolean(wf.isCritical ?? args?.[0]?.isCritical);\nif (!isCrit) return {};\n\nreturn {\n  damageRoll: \"1d4\",\n  flavor: \"Partbreaker\",\n};\n",
