        "name": "U.Firecell Stone Rune (Armor)",
        "type": "script",
        "scope": "global",
        "author": "",
        "img": "icons/svg/dice-target.svg",
        "command": "// U.Firecell Stone - Shield (+1 AC when you use an AC-boosting reaction)\n// Activity \"Shield Rune Bonus\" (reaction) applies the AE; this confirms in chat.\n\nconst macroPass = String(args?.[0]?.macroPass ?? workflow?.macroPass ?? \"\").toLowerCase();\nif (macroPass && !macroPass.includes(\"postactiveeffects\") && macroPass !== \"\") return;\n\nconst actorDoc = actor ?? workflow?.actor ?? item?.actor;\nif (!actorDoc) return;\n\nawait ChatMessage.create({\n  speaker: ChatMessage.getSpeaker({ actor: actorDoc }),\n  content: `<div class=\"dnd5e2\"><p><strong>Shield</strong> (U.Firecell Stone): +1 AC until the start of your next turn.</p></div>`,\n});\n",
        "folder": null,
