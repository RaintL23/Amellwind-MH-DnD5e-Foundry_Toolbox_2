{
  "_id": "YoHpT0hpTlZ8U0zC",
  "name": "Thunderblight",
  "type": "feat",
  "img": "icons/magic/lightning/bolt-forked-blue.webp",
  "system": {
    "description": {
      "value": "<p><strong>Amellwind Condition</strong></p><p>An afflicted creature has disadvantage on saving throws to be stunned. If the creature takes lightning or thunder damage while already under the effects of thunderblight, it must make a Constitution saving throw with a DC equal to the creature's Carve DC or be stunned until the end of its next turn.</p>\n<p><em>Status indicates the blight; stun-on-shock / save disadvantage vs stun is enforced by hunt macros / GM (not a blanket Con-save penalty).</em></p>\n<p><em>Toggle from the token HUD, or use <strong>Apply Affliction</strong> (Midi applies the Active Effect + status icon).</em></p>",
      "chat": "<p>Disadvantage on saves against being stunned. Lightning/thunder damage while blighted: Con save (Carve DC) or stunned until end of next turn.</p>"
    },
