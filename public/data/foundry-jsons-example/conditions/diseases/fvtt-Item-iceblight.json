  "name": "Iceblight",
  "type": "feat",
  "img": "icons/magic/water/barrier-ice-wall-snow.webp",
  "system": {
    "description": {
      "value": "<p><strong>Amellwind Disease</strong></p><p><em>Iceblight is considered a type of disease for the purposes of features that grant advantage on saves against or immunity to diseases.</em></p>\n<p>A creature who is afflicted with iceblight is chilled to the bone. The creature can't use reactions. Its speed is halved. It can't make more than one attack on its turn.</p>\n<p><em>Toggle from the token HUD, or use <strong>Apply Affliction</strong> (Midi applies the Active Effect + status icon).</em></p>",
      "chat": "<p>Disease. No reactions; half speed; only one attack on your turn.</p>"
    },
